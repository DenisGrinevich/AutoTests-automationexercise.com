<Configuration status="WARN">
    <Appenders>
        <Console name="Console">
            <PatternLayout pattern="%-5level | %d{yyyy-MM-dd HH:mm:ss.SSS} | %logger{36} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>